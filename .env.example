# Copy to .env in the repo root or backend/ (python-dotenv searches upward from backend/) and fill in your Azure OpenAI values.

AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# Chat deployment used for extraction, vision OCR and RAG answers (must support image input for OCR)
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Embedding deployment used by the RAG store
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# FREE alternative to Azure for extraction and chat answers: OpenRouter free models (no card needed).
# Create a key at https://openrouter.ai/keys. Certificate text is sent to OpenRouter and the model host.
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=google/gemma-4-31b-it:free   # any model id ending in ':free'

# Any other OpenAI-compatible API (Groq, Gemini's OpenAI endpoint, a local Ollama server, ...):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key
# LLM_MODEL=<model id from that provider>

# Hugging Face Inference Providers (needs paid credits; free accounts get HTTP 402).
# Create a free token (read access) at https://huggingface.co/settings/tokens. Certificate text is sent to Hugging Face.
# HF_TOKEN=hf_your_token_here
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct   # cheaper: meta-llama/Llama-3.1-8B-Instruct (accept its licence on HF first)
# LLM_PROVIDER=auto                    # auto (Azure > OpenRouter > custom > Hugging Face) | azure | openrouter | custom | huggingface

# Everything works without Azure: local OCR (RapidOCR) + rule-based extraction are used automatically.
# Optional
# OCR_PROVIDER=auto            # auto (Azure vision if configured, else local) | azure | local
# EXTRACTION_PROVIDER=auto     # auto (LLM consensus if configured, else rules) | llm | rules
# RAG_EMBEDDINGS=auto          # auto (Azure if configured, else local all-MiniLM-L6-v2, ~80 MB download) | azure | local
# EXTRACTION_ATTEMPTS=3        # self-consistency runs per document
# EXTRACTION_TEMPERATURE=0.7   # sampling temperature for those runs
# USE_MOCK_LLM=1               # offline demo: return fixed mock extraction when no Azure key
# FLASK_DEBUG=1                # enable Flask debug mode (never in production)
# PORT=5000
